# ===== 绝不入库：含你的订阅 token / 节点密码 =====
config.yaml
config.yaml.bak
# build.sh 从本地 config.yaml（或模板）生成，名字固定叫 config.yaml
luci-app/files/config.yaml
packaging/docker/config.yaml

# ===== 运行期数据 =====
cache/
data/
out*.yaml

# ===== 编译产物：只留两个给在线安装脚本用的二进制 =====
dist/*
!dist/subgen-linux-arm64
!dist/subgen-linux-amd64
# 在线安装（scripts/remote-install.sh）只发一次请求，靠这两个包；
# 里面用的是 config.example.yaml 模板，不含任何订阅信息
!dist/subgen-openwrt-arm64.tar.gz
!dist/subgen-openwrt-amd64.tar.gz
subgen.exe
