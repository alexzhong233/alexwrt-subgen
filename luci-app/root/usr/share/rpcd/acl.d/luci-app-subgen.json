{
	"luci-app-subgen": {
		"description": "subgen 订阅转换控制台",
		"read": {
			"ubus": {
				"session": [ "access" ],
				"luci": [ "getBoardJSON", "getStatus" ],
				"subgen": [ "status", "start", "stop", "restart" ]
			},
			"uci": [ "subgen" ]
		},
		"write": {
			"ubus": {
				"subgen": [ "status", "start", "stop", "restart" ]
			},
			"uci": [ "subgen" ]
		}
	}
}
