#!/bin/sh /etc/rc.common
# subgen 服务。配置文件路径以 /etc/config/subgen 的 cfg.config 为准（sysupgrade 会保留这个文件），
# 所以升级固件后仍然指向同一份配置；没写就用默认路径。
START=98
STOP=10
USE_PROCD=1
PROG=/usr/bin/subgen

start_service() {
	local CONF
	config_load subgen
	config_get CONF cfg config "/etc/subgen/config.yaml"
	[ -x "$PROG" ] || { logger -t subgen "找不到 $PROG"; return 1; }
	[ -f "$CONF" ] || { logger -t subgen "找不到 $CONF"; return 1; }
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "subgen"
}
